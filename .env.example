# Build-time feature flag: enable this only for a dashboard preview deployment.
REACT_APP_EXPERIENCES_PREVIEW=false

# Browser-safe delivery configuration. Keep real values only in the ignored .env.local file.
REACT_APP_CONTENTFUL_SPACE_ID=
REACT_APP_CONTENTFUL_ENVIRONMENT_ID=
REACT_APP_CONTENTFUL_DELIVERY_TOKEN=
REACT_APP_CONTENTFUL_PREVIEW_TOKEN=
REACT_APP_CONTENTFUL_USE_PREVIEW=true
REACT_APP_CONTENTFUL_EXPERIENCE_ID=ping-pong-dashboard

# Provisioning configuration. These are never exposed to the browser.
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT_ID=
CONTENTFUL_CMA_TOKEN=
CONTENTFUL_TOURNAMENT_ID=3OWG1Azlu0l7DRvWSsQOxG
